APP_NAME="UNIQA SUITES"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://uniqa-suites.test
# Runtime stays UTC; property display timezone is separate (see config/uniqa.php)
APP_TIMEZONE=UTC
UNIQA_DISPLAY_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_uniquasuites
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@uniqa-suites.test"
MAIL_FROM_NAME="${APP_NAME}"

# Official public contact channels. Leave blank until the owner supplies them:
# the site then shows "copy inquiry" without inventing a link.
# One-click sign-in on the login page. Local or APP_ENV=demo trials only; production ignores it.
DEMO=false
UNIQA_MESSENGER_URL=https://m.me/uniqasuitescdo
UNIQA_INSTAGRAM_URL=
UNIQA_FACEBOOK_URL=https://www.facebook.com/uniqasuitescdo
UNIQA_CONTACT_PHONE=
UNIQA_CONTACT_EMAIL=

VITE_APP_NAME="${APP_NAME}"
